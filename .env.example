# evil-read-arxiv 环境变量配置模板
#
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 修改 .env.local 中的值（不要提交到 Git）
# 3. 在你的 shell 配置中加载这些变量，或使用 direnv/python-dotenv 自动加载
#
# 注意：.env.local 已添加到 .gitignore，可以安全存储敏感信息

# =============================================================================
# Obsidian Vault 配置
# =============================================================================

# Obsidian Vault 路径（所有技能都需要）
export OBSIDIAN_VAULT_PATH="/Users/yourname/Documents/Obsidian Vault"


# =============================================================================
# NotebookLM Workflow 邮件配置（QQ 邮箱）
# =============================================================================

# 发件人邮箱地址（你的 QQ 邮箱，可使用 foxmail 别名）
export EMAIL_SENDER="your-qq-number@foxmail.com"

# 收件人邮箱地址（多个收件人用逗号分隔）
export EMAIL_RECIPIENTS="recipient1@company.com,recipient2@example.com"

# SMTP 登录用户名（通常与发件人相同）
export EMAIL_USERNAME="your-qq-number@foxmail.com"

# SMTP 授权码（不是 QQ 密码！需要在 QQ 邮箱设置中生成）
# 获取方式：
# 1. 登录 https://mail.qq.com
# 2. 设置 → 账户
# 3. 开启 POP3/SMTP 服务
# 4. 生成授权码
export EMAIL_PASSWORD="your-authorization-code-here"

# SMTP 服务器（QQ 邮箱固定为 smtp.qq.com）
export EMAIL_SMTP_SERVER="smtp.qq.com"

# SMTP 端口（587 使用 STARTTLS，465 使用 SSL）
export EMAIL_SMTP_PORT="587"

# 是否使用 SSL（true 或 false）
export EMAIL_USE_SSL="true"


# =============================================================================
# Semantic Scholar API（可选）
# =============================================================================

# Semantic Scholar API Key（可选，减少 rate limiting）
# 免费申请：https://www.semanticscholar.org/product/api#api-key
# export SEMANTIC_SCHOLAR_API_KEY="your-api-key-here"


# =============================================================================
# 其他配置
# =============================================================================

# Python 路径（如果需要指定 Python 版本）
# export PYTHON_BIN="/usr/bin/python3"

# 自定义数据库路径（可选，默认：~/.notebooklm/workflow.db）
# export NOTEBOOKLM_WORKFLOW_DB_PATH="/path/to/workflow.db"
